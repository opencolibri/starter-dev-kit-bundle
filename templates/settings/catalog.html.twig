{#
 # The datasets the shop can load, searched as you type, each opening its page: its products, and the button that
 # loads it. The links to make a dataset of one's own are in the header of the page (settings/catalog/actions).
 #}
{% set state = dev_kit_state() %}
{% if state is not null %}
    {{ component('DevKit:DatasetBrowser', {current: state.dataset|default(null)}) }}
{% endif %}
