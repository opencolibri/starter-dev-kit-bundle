{# Read before the nested components: inside <twig:shadcn:Card>, "this" is the card. #}
{% set loaded = this.loaded %}
{% set this_plan = this.plan %}
<div {{ attributes }}>
    <twig:shadcn:Card class="{{ loaded ? '' : 'border-primary/40' }}">
        <twig:shadcn:Card:Content class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-col gap-0.5">
                    <span class="font-medium">{{ (loaded ? 'opencolibri_dev_kit.ui.loaded_in_the_shop' : 'opencolibri_dev_kit.ui.load_into_the_shop')|trans }}</span>
                    <span class="text-sm text-muted-foreground">
                        {{- (loaded ? 'opencolibri_dev_kit.ui.loaded_description' : (dataset == 'sylius' ? 'opencolibri_dev_kit.ui.load_sylius_description' : 'opencolibri_dev_kit.ui.load_description'))|trans -}}
                    </span>
                </div>
                {% if not loaded and not planned %}
                    {{ component('dev_kit:action_button', {action: 'showPlan', label: 'opencolibri_dev_kit.ui.load_this_catalog'|trans, icon: 'lucide:download'}) }}
                {% elseif loaded and editable %}
                    {{ component('dev_kit:action_button', {action: 'reload', label: 'opencolibri_dev_kit.ui.reload_catalog'|trans, icon: 'lucide:refresh-cw', variant: 'outline'}) }}
                {% endif %}
            </div>
            {% if loaded and editable %}
                <p class="text-xs text-muted-foreground">{{ 'opencolibri_dev_kit.ui.reload_catalog_help'|trans }}</p>
                {{ component('dev_kit:message', {message: error}) }}
            {% endif %}
            {% if planned and not loaded %}
                {{ component('dev_kit:plan', {plan: this_plan, error: error}) }}
            {% endif %}
        </twig:shadcn:Card:Content>
    </twig:shadcn:Card>
</div>
