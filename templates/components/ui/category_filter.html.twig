{#-
 # The category pills of a live component on FiltersByCategoryTrait: "All", then each category with the number of its
 # items, bound to its "category" prop. Hidden with a single category (a catalog without any).
 #}
{%- props categories = [], picked = '', total = 0, legend = '' -%}
{%- if categories|length > 1 -%}
    <fieldset>
        <legend class="sr-only">{{ legend }}</legend>
        <div class="flex flex-wrap gap-2">
            {% for item in [{name: '', label: 'opencolibri_dev_kit.ui.all_categories'|trans, count: total}]|merge(categories) %}
                <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-medium transition-colors hover:bg-accent has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-foreground has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-ring/50">
                    <input type="radio" name="category" value="{{ item.name }}" data-model="category" class="sr-only"{% if item.name == picked %} checked{% endif %}>
                    {{ item.label ?? 'opencolibri_dev_kit.ui.other_category'|trans }}
                    <span class="text-xs opacity-70">{{ item.count }}</span>
                </label>
            {% endfor %}
        </div>
    </fieldset>
{%- endif -%}
