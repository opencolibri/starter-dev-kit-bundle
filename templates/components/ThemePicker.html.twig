{# Read before the nested components: inside <twig:shadcn:Card>, "this" is the card. #}
{% set this_current = this.current %}
{% set this_plan = this.plan %}
<div {{ attributes }}>
    <twig:shadcn:Card>
        <twig:shadcn:Card:Header>
            <twig:shadcn:Card:Title>{{ 'opencolibri_dev_kit.ui.storefront_theme'|trans }}</twig:shadcn:Card:Title>
            <twig:shadcn:Card:Description>{{ 'opencolibri_dev_kit.ui.storefront_theme_description'|trans }}</twig:shadcn:Card:Description>
        </twig:shadcn:Card:Header>
        <twig:shadcn:Card:Content class="flex flex-col gap-4">
            <fieldset>
                <legend class="sr-only">{{ 'opencolibri_dev_kit.ui.theme'|trans }}</legend>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5">
                    {% for item in [{name: 'default'}]|merge(themes) %}
                        {% set name = item.name == 'default' ? 'opencolibri_dev_kit.ui.default_theme'|trans : item.label|default(item.name|replace({'_': ' '})|title) %}
                        <label class="group flex cursor-pointer flex-col gap-1.5 rounded-lg border p-1.5 transition-colors hover:bg-accent has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/30 has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-ring/50">
                            <input type="radio" name="theme" value="{{ item.name }}" data-model="theme" class="sr-only"{% if item.name == theme %} checked{% endif %}>
                            {% if item.name == 'default' %}
                                <span class="flex aspect-[8/5] items-center justify-center rounded-md bg-muted text-muted-foreground">
                                    {{ ux_icon('lucide:store', {class: 'size-6', 'aria-hidden': 'true'}) }}
                                </span>
                            {% else %}
                                <span class="block overflow-hidden rounded-md bg-muted">
                                    <img src="{{ path('opencolibri_dev_kit_theme_preview', {theme: item.name, scheme: 'light'}) }}" alt="" width="480" height="300" loading="lazy" class="aspect-[8/5] w-full object-cover dark:hidden">
                                    <img src="{{ path('opencolibri_dev_kit_theme_preview', {theme: item.name, scheme: 'dark'}) }}" alt="" width="480" height="300" loading="lazy" class="hidden aspect-[8/5] w-full object-cover dark:block">
                                </span>
                            {% endif %}
                            <span class="flex items-center justify-between gap-2 px-0.5 text-sm font-medium">
                                <span class="truncate">{{ name }}</span>
                                {% if item.name == this_current %}
                                    <twig:shadcn:Badge variant="secondary">{{ 'opencolibri_dev_kit.ui.current'|trans }}</twig:shadcn:Badge>
                                {% endif %}
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
            {{ component('dev_kit:plan', {plan: this_plan, error: error}) }}
        </twig:shadcn:Card:Content>
    </twig:shadcn:Card>
</div>
