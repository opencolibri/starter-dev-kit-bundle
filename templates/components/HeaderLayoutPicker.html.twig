{# Read before the nested components: inside <twig:shadcn:Card>, "this" is the card. #}
{% set this_current = this.current %}
{% set this_plan = this.plan %}
{% set current = this_current %}
<div {{ attributes }}>
    <twig:shadcn:Card>
        <twig:shadcn:Card:Header>
            <twig:shadcn:Card:Title>{{ 'opencolibri_dev_kit.ui.header_layout'|trans }}</twig:shadcn:Card:Title>
            <twig:shadcn:Card:Description>
                {{- (placements ? 'opencolibri_dev_kit.ui.header_layout_description' : 'opencolibri_dev_kit.ui.header_layout_default_theme')|trans -}}
            </twig:shadcn:Card:Description>
        </twig:shadcn:Card:Header>
        {% if placements %}
            <twig:shadcn:Card:Content class="flex flex-col gap-3">
                <div class="grid items-start gap-4 md:grid-cols-2">
                    {{ component('dev_kit:header_preview', {menu: menu, search: search}) }}
                    <div class="flex flex-col gap-3">
                        <div class="flex flex-col gap-1.5">
                            <twig:shadcn:Label for="header-menu">{{ 'opencolibri_dev_kit.ui.header_menu'|trans }}</twig:shadcn:Label>
                            <twig:shadcn:NativeSelect id="header-menu" data-model="menu">
                                {% for item in placements.menus %}
                                    <option value="{{ item }}"{% if item == menu %} selected{% endif %}>{{ ('opencolibri_dev_kit.ui.header_menu_' ~ item)|trans }}{% if item == current.menu|default %} ({{ 'opencolibri_dev_kit.ui.current'|trans }}){% endif %}</option>
                                {% endfor %}
                            </twig:shadcn:NativeSelect>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <twig:shadcn:Label for="header-search">{{ 'opencolibri_dev_kit.ui.header_search'|trans }}</twig:shadcn:Label>
                            <twig:shadcn:NativeSelect id="header-search" data-model="search">
                                {% for item in placements.searches %}
                                    <option value="{{ item }}"{% if item == search %} selected{% endif %}>{{ ('opencolibri_dev_kit.ui.header_search_' ~ item)|trans }}{% if item == current.search|default %} ({{ 'opencolibri_dev_kit.ui.current'|trans }}){% endif %}</option>
                                {% endfor %}
                            </twig:shadcn:NativeSelect>
                        </div>
                    </div>
                </div>
                {{ component('dev_kit:plan', {plan: this_plan, error: error}) }}
            </twig:shadcn:Card:Content>
        {% endif %}
    </twig:shadcn:Card>
</div>
